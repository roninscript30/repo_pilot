{
  "name": "gitos",
  "productName": "GitOS",
  "version": "0.1.0",
  "description": "GitOS - open-source, desktop-first Repository Operating Platform",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
